{
  "name": "hannah-wen-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"content/**/*.json\" \"site/**/*.{css,json}\" \"scripts/**/*.mjs\" package.json .prettierrc.json .github/workflows/pages.yml",
    "format:check": "prettier --check \"content/**/*.json\" \"site/**/*.{css,json}\" \"scripts/**/*.mjs\" package.json .prettierrc.json .github/workflows/pages.yml"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "marked": "18.0.14",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}

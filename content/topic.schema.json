{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwen99.github.io/hwpfolio/schemas/topic.schema.json",
  "title": "Portfolio topic metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "type", "status", "audience", "tools"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["case-study", "writing-sample"]
    },
    "status": {
      "enum": ["professional", "self-directed"]
    },
    "audience": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "tocDepth": {
      "type": "integer",
      "enum": [2, 3]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "writing-sample" } } },
      "then": { "properties": { "status": { "const": "self-directed" } } }
    }
  ]
}

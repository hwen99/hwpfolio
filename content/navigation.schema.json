{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwen99.github.io/hwpfolio/schemas/navigation.schema.json",
  "title": "Portfolio content map",
  "type": "object",
  "additionalProperties": false,
  "required": ["collections"],
  "properties": {
    "$schema": { "type": "string" },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/collection" }
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "description", "source", "output", "groups"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^content/.+\\.md$" },
        "output": { "type": "string", "pattern": "^[a-z0-9-]+\\.html$" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "topics"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^content/.+\\.md$" }
        }
      }
    }
  }
}
